# Ignore node_modules - auto-generated and huge
node_modules/

# Ignore environment variable files - sensitive data
.env

# Ignore uploaded files - not needed in Git (can be regenerated)
uploads/

# Ignore OS/system-specific files
.DS_Store
Thumbs.db

# Optional: logs or temporary debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code-specific files (optional)
.vscode/
